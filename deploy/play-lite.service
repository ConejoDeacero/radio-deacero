# /etc/systemd/system/play-lite.service
# Ajusta User y las rutas a tu instalación.
[Unit]
Description=DEACERO Play Lite
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/DEACEROPLAY-lite
Environment=PORT=8000
# Opcional: Environment=YTDLP_EXTRA=--cookies /home/pi/cookies.txt
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
